<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-specific implementations: Win32/WinRT interop, system monitors (processes, sessions,
    focus), and the action/condition handlers that actually change Windows settings.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>AutoSettings.Platform</RootNamespace>
    <!-- Interop code: classic DllImport is used on purpose (by-value strings in structs); docs are on the Core API. -->
    <NoWarn>$(NoWarn);CS1591;SYSLIB1054;SYSLIB1096</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.*" />
    <PackageReference Include="System.Management" Version="10.*" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.*" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoSettings.Core\AutoSettings.Core.csproj" />
  </ItemGroup>

</Project>
