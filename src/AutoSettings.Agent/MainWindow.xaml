<ui:FluentWindow x:Class="AutoSettings.Agent.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:AutoSettings.Agent.Localization"
                 Title="AutoSettings"
                 Width="1140" Height="740" MinWidth="820" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Icon="/Assets/AutoSettings.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="AutoSettings" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <DockPanel Margin="12,4,8,12">
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="HeaderStatus" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="8,0,8,8" />
                    <Button x:Name="PauseButton" Click="OnPauseClick" HorizontalAlignment="Stretch" />
                </StackPanel>
                <ListBox x:Name="Navigation" SelectionChanged="OnNavigationChanged" BorderThickness="0" Background="Transparent">
                    <ListBoxItem Tag="automations" Padding="12,10" Content="{loc:T Automations}" IsSelected="True" />
                    <ListBoxItem Tag="profiles" Padding="12,10" Content="{loc:T Profiles}" />
                    <ListBoxItem Tag="templates" Padding="12,10" Content="{loc:T Templates}" />
                    <ListBoxItem Tag="activity" Padding="12,10" Content="{loc:T Activity}" />
                    <ListBoxItem Tag="settings" Padding="12,10" Content="{loc:T Settings}" />
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1" Margin="12,4,20,16">
                <!-- Automations -->
                <DockPanel x:Name="AutomationsPage">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T Automations}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T AutomationsHint}" />
                        <WrapPanel>
                            <ui:Button Margin="0,0,8,8" Appearance="Primary" Content="{loc:T New}" Click="OnNewAutomationClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T Edit}" Click="OnEditAutomationClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T Duplicate}" Click="OnDuplicateAutomationClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T Delete}" Click="OnDeleteAutomationClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="↑" ToolTip="{loc:T MoveUp}" Click="OnMoveAutomationUpClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="↓" ToolTip="{loc:T MoveDown}" Click="OnMoveAutomationDownClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T RunNow}" Click="OnRunClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T RunIgnoringConditions}" Click="OnRunForcedClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T Import}" Click="OnImportClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T Export}" Click="OnExportClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T EditWholeFile}" Click="OnEditFileClick" />
                        </WrapPanel>
                    </StackPanel>
                    <ListView x:Name="AutomationList" SelectionMode="Extended" MouseDoubleClick="OnEditAutomationClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:T On}" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:ToggleSwitch IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnToggleEnabledClick" Tag="{Binding Id}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{loc:T Name}" Width="200" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="{loc:T When}" Width="220" DisplayMemberBinding="{Binding When}" />
                                <GridViewColumn Header="{loc:T If}" Width="170" DisplayMemberBinding="{Binding If}" />
                                <GridViewColumn Header="{loc:T Then}" Width="260" DisplayMemberBinding="{Binding Then}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <!-- Profiles -->
                <DockPanel x:Name="ProfilesPage" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T Profiles}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T ProfilesHint}" />
                        <WrapPanel>
                            <ui:Button Margin="0,0,8,8" Appearance="Primary" Content="{loc:T New}" Click="OnNewProfileClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T Edit}" Click="OnEditProfileClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T Duplicate}" Click="OnDuplicateProfileClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T Delete}" Click="OnDeleteProfileClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T Apply}" Click="OnApplyProfileClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T Revert}" Click="OnRevertProfileClick" />
                        </WrapPanel>
                    </StackPanel>
                    <ListView x:Name="ProfileList" MouseDoubleClick="OnEditProfileClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:T Status}" Width="230" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="{loc:T Name}" Width="180" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="{loc:T Priority}" Width="80" DisplayMemberBinding="{Binding Priority}" />
                                <GridViewColumn Header="{loc:T Settings}" Width="440" DisplayMemberBinding="{Binding Actions}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <!-- Templates -->
                <DockPanel x:Name="TemplatesPage" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T Templates}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T TemplatesHint}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TemplateList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="280" Height="190" Margin="0,0,12,12" Padding="16" CornerRadius="8" BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Bottom" Content="{loc:T AddTemplate}" Tag="{Binding Id}" Click="OnAddTemplateClick" HorizontalAlignment="Left" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Icon}" FontSize="26" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,4" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Activity -->
                <DockPanel x:Name="ActivityPage" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T Activity}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T ActivityHint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="PersonalActivity" Content="{loc:T MyActivity}" IsChecked="True" Checked="OnActivitySourceChanged" Margin="0,0,16,0" />
                            <RadioButton x:Name="MachineActivity" Content="{loc:T MachineActivity}" Checked="OnActivitySourceChanged" />
                            <Button Content="{loc:T Clear}" Click="OnClearActivityClick" Margin="24,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <ListView x:Name="ActivityList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="36">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Icon}" Foreground="{Binding Brush}" FontWeight="Bold" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{loc:T Time}" Width="80" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="{loc:T WhatHappened}" Width="760">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T Settings}" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T Appearance}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:T Language}" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,4" SelectionChanged="OnLanguageChanged" />
                            <TextBlock Grid.Row="1" Text="{loc:T Theme}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeBox" Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,4" SelectionChanged="OnThemeChanged" />
                        </Grid>
                        <TextBlock x:Name="RestartHint" Style="{StaticResource Hint}" Text="{loc:T RestartForLanguage}" Visibility="Collapsed" Margin="0,8,0,0" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T Updates}" />
                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock x:Name="UpdateDetails" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="CheckUpdatesButton" Style="{StaticResource ToolbarButton}" Content="{loc:T CheckNow}" Click="OnCheckUpdatesClick" />
                            <ui:Button x:Name="InstallUpdateButton" Appearance="Primary" Margin="0,0,8,0" Visibility="Collapsed" Click="OnInstallUpdateClick" />
                            <Button x:Name="WhatsNewButton" Style="{StaticResource ToolbarButton}" Content="{loc:T WhatsNew}" Visibility="Collapsed" Click="OnWhatsNewClick" />
                        </WrapPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T UpdateModeLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:Name="UpdateModeBox" Grid.Column="1" Width="320" HorizontalAlignment="Left" Margin="0,4" SelectionChanged="OnUpdateSettingsChanged" />
                        </Grid>
                        <ui:ToggleSwitch x:Name="BetaSwitch" Content="{loc:T IncludeBetas}" Margin="0,4,0,0" Checked="OnUpdateSettingsChanged" Unchecked="OnUpdateSettingsChanged" />
                        <TextBlock x:Name="UpdateLockedHint" Style="{StaticResource Hint}" Text="{loc:T UpdateSettingsLocked}" Visibility="Collapsed" Margin="0,4,0,0" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T Testing}" />
                        <ui:ToggleSwitch x:Name="DryRunSwitch" Content="{loc:T DryRun}" Checked="OnDryRunChanged" Unchecked="OnDryRunChanged" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T Status}" />
                        <TextBlock x:Name="StatusDetails" TextWrapping="Wrap" LineHeight="22" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T EditWholeFile}" Click="OnEditFileClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T OpenAutomationsFolder}" Click="OnOpenConfigFolderClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T OpenLogFolder}" Click="OnOpenLogFolderClick" />
                            <Button Style="{StaticResource ToolbarButton}" Content="{loc:T Documentation}" Click="OnDocsClick" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
