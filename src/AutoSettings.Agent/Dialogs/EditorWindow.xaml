<ui:FluentWindow x:Class="AutoSettings.Agent.Dialogs.EditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:AutoSettings.Agent.Localization"
                 xmlns:vm="clr-namespace:AutoSettings.Agent.ViewModels"
                 xmlns:editor="clr-namespace:AutoSettings.Agent.Editor"
                 Width="1000" Height="780" MinWidth="720" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <!-- A trigger, condition or action card. -->
        <DataTemplate DataType="{x:Type vm:ComponentViewModel}">
            <Border Margin="0,0,0,10" Padding="14,10" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="↑" Command="{Binding MoveUpCommand}" ToolTip="{loc:T MoveUp}" Padding="10,4" Margin="4,0,0,0" />
                            <Button Content="↓" Command="{Binding MoveDownCommand}" ToolTip="{loc:T MoveDown}" Padding="10,4" Margin="4,0,0,0" />
                            <Button Content="✕" Command="{Binding RemoveCommand}" ToolTip="{loc:T Remove}" Padding="10,4" Margin="4,0,0,0" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label"
                                  MinWidth="340" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,6" />
                    <ItemsControl ItemsSource="{Binding Fields}" />
                    <TextBlock Text="{Binding Errors}" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One field inside a card. -->
        <DataTemplate DataType="{x:Type vm:FieldViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" ToolTip="{Binding Description}" VerticalAlignment="Top" Margin="0,8,8,0" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1">
                    <DockPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                        <Button DockPanel.Dock="Right" Content="{loc:T Browse}" Margin="6,0,0,0" Click="OnBrowseClick"
                                Visibility="{Binding IsPath, Converter={StaticResource BoolToVisibility}}" />
                        <Button DockPanel.Dock="Right" Content="{loc:T PickApp}" Margin="6,0,0,0" Click="OnPickAppClick"
                                Visibility="{Binding IsAppList, Converter={StaticResource BoolToVisibility}}" />
                        <Button DockPanel.Dock="Right" Content="{loc:T PickUser}" Margin="6,0,0,0" Click="OnPickUserClick"
                                Visibility="{Binding IsUserList, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Placeholder}"
                                    AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap" ToolTip="{Binding Description}" />
                    </DockPanel>
                    <ComboBox Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"
                              ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedValue}" MinWidth="240" HorizontalAlignment="Left" ToolTip="{Binding Description}" />
                    <StackPanel Visibility="{Binding IsConditionList, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Nested.Items}" />
                        <Button Content="{loc:T AddCondition}" Tag="{Binding Nested}" Click="OnAddClick" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" />

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="16,0,16,0" SelectionChanged="OnTabChanged">
            <TabItem Header="{loc:T Visual}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:T Name}" Margin="0,8,8,4" />
                            <ui:TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="{loc:T Id}" Margin="0,8,8,4" />
                            <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Text="{loc:T Description}" Margin="0,8,8,4" />
                            <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsAutomation, Converter={StaticResource BoolToVisibility}}">
                                    <ui:ToggleSwitch IsChecked="{Binding Enabled}" Content="{loc:T Enabled}" Margin="0,0,24,0" />
                                    <TextBlock Text="{loc:T Cooldown}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ui:TextBox Text="{Binding Cooldown, UpdateSourceTrigger=PropertyChanged}" Width="120" PlaceholderText="30s, 5m" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsProfile, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:T Priority}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ui:TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding IsAutomation, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T WhenSection}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{loc:T WhenHint}" />
                            <ItemsControl ItemsSource="{Binding Triggers.Items}" />
                            <Button Content="{loc:T AddTrigger}" Tag="{Binding Triggers}" Click="OnAddClick" />

                            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T IfSection}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{loc:T IfHint}" />
                            <ItemsControl ItemsSource="{Binding Conditions.Items}" />
                            <Button Content="{loc:T AddCondition}" Tag="{Binding Conditions}" Click="OnAddClick" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T ThenSection}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T ThenHint}" />
                        <ItemsControl ItemsSource="{Binding Actions.Items}" />
                        <Button Content="{loc:T AddAction}" Tag="{Binding Actions}" Click="OnAddClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="YAML">
                <editor:YamlEditor x:Name="Yaml" Margin="0,8,0,0" />
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="16,8,16,16">
            <ListBox x:Name="IssueList" MaxHeight="110" Visibility="Collapsed" MouseDoubleClick="OnIssueDoubleClick" Margin="0,0,0,8" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="TestButton" Content="{loc:T Test}" Click="OnTestClick" Margin="0,0,8,0" />
                    <Button Content="{loc:T Cancel}" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" />
                    <ui:Button Content="{loc:T Save}" Appearance="Primary" IsDefault="True" Click="OnSaveClick" />
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
