<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generates docs/reference (one page per trigger, condition and action) and the JSON Schema
    from the component catalog, so the documentation always matches the code.
      dotnet run --project src/AutoSettings.DocGen            (write)
      dotnet run --project src/AutoSettings.DocGen -- --check (fail if out of date; used by CI)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoSettings.DocGen</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoSettings.Core\AutoSettings.Core.csproj" />
  </ItemGroup>

</Project>
