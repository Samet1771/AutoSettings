<Project Sdk="Microsoft.NET.Sdk">

  <!-- The "autosettings-plugin" command for plugin authors: pack, validate, describe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoSettings.PluginTool</RootNamespace>
    <AssemblyName>autosettings-plugin</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>autosettings-plugin</ToolCommandName>
    <PackageId>AutoSettings.PluginTool</PackageId>
    <!-- Released together with the SDK (see docs/plugins/versioning.md). -->
    <Version>1.0.0</Version>
    <Description>Packs and checks AutoSettings plugins.</Description>
    <PackageProjectUrl>https://github.com/Samet1771/AutoSettings</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoSettings.Core\AutoSettings.Core.csproj" />
  </ItemGroup>

</Project>
